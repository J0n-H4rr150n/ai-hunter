# Google Cloud Platform
GCP_PROJECT_ID=project-id
GCP_LOCATION=us-central1

# Database
DATABASE_URL=postgresql://someuser:some_password_here@localhost:33001/db_name_here

# Redis
REDIS_URL=redis://localhost:33002

# Backend API
BACKEND_PORT=33003

# Frontend
FRONTEND_PORT=33004

