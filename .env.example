# --- Local LLM (llama.cpp / llama-server, OpenAI-compatible) ----------------
# Nothing leaves this host. Start the model with something like:
#   llama-server --model /path/to/Qwen3.8-27B-MTP-Q8_0.gguf --mmproj /path/to/mmproj-F32.gguf \
#                --host 0.0.0.0 --port 30087 --alias qwen38-27b-q8 --ctx-size 32768 --jinja
LLM_BASE_URL=http://127.0.0.1:30087/v1
LLM_MODEL=qwen38-27b-q8
LLM_API_KEY=local

# The agent sends screenshots; set false if your model has no vision projector.
LLM_SUPPORTS_VISION=true

LLM_TEMPERATURE=0.4
# Reasoning models spend much of the budget thinking before the answer begins;
# too small a cap truncates mid-thought and returns an empty completion.
LLM_MAX_TOKENS=4096

# Streaming is what makes a slow model safe: the deadline becomes the gap
# between tokens rather than the total duration of the answer.
LLM_STREAM=true

# Thinking improves quality but costs time. Off for strict-JSON calls by
# default, where the answer is a structured object rather than an argument
# (measured 2.4x faster, still valid JSON).
LLM_ENABLE_THINKING=true
LLM_THINK_ON_JSON=false

# --- Timeouts ---------------------------------------------------------------
# Derived from the served model, not guessed. A slow model is accommodated; a
# dead one is still detected. LLM_TOTAL_TIMEOUT is computed from the others as
# MAX_TOKENS / MIN_TOKENS_PER_SEC + FIRST_TOKEN_TIMEOUT unless set explicitly.
LLM_CONNECT_TIMEOUT=15
LLM_FIRST_TOKEN_TIMEOUT=300
LLM_STALL_TIMEOUT=60
LLM_MIN_TOKENS_PER_SEC=4
# LLM_TOTAL_TIMEOUT=1324

# --- Target TLS -------------------------------------------------------------
# An expired or self-signed certificate on a target is a finding, not a reason
# to refuse to connect, so verification is off and the certificate is inspected
# and recorded instead. Set true to enforce it.
VERIFY_TLS=false
# TARGET_CA_BUNDLE=/path/to/lab-ca.crt

# --- Storage ----------------------------------------------------------------
DATABASE_URL=postgresql://hunter:hunter_pass_dev@127.0.0.1:33001/ai_hunter
HIVE_BUCKET_PATH=./hive_bucket

# pgvector semantic search over past findings. Off by default: it pulls in
# TensorFlow. Enable with `poetry install -E embeddings`.
DISABLE_EMBEDDINGS=true

# --- Single-port host (serve.py) --------------------------------------------
# This is the port you open from your phone.
PORT=30170
TLS_CERT=~/models/spa/certs/server.crt
TLS_KEY=~/models/spa/certs/server.key

LOG_LEVEL=INFO

# --- Split Docker setup only ------------------------------------------------
BACKEND_PORT=33003
FRONTEND_PORT=33004
