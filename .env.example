# Local LLM (llama.cpp / llama-server, OpenAI-compatible API)
# Nothing leaves this host. Start the model with something like:
#   llama-server --model /path/to/Qwen3.8-27B-MTP-Q8_0.gguf --mmproj /path/to/mmproj-F32.gguf \
#                --host 0.0.0.0 --port 30087 --alias qwen38-27b-q8 --ctx-size 32768 --jinja
LLM_BASE_URL=http://127.0.0.1:30087/v1
LLM_MODEL=qwen38-27b-q8
# The agent sends screenshots; set false if your model has no vision projector.
LLM_SUPPORTS_VISION=true
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=300

# Database
DATABASE_URL=postgresql://hunter:hunter_pass_dev@127.0.0.1:33001/ai_hunter

# Redis
REDIS_URL=redis://127.0.0.1:33002

# Single-port SPA host (serve.py) — this is the port you open from your phone
PORT=30170

# TLS for the single-port host (falls back to plain HTTP if these are absent)
TLS_CERT=~/models/spa/certs/server.crt
TLS_KEY=~/models/spa/certs/server.key

# Split Docker setup only
BACKEND_PORT=33003
FRONTEND_PORT=33004

# Set to 'true' to disable all embedding functionality (default: disabled)
DISABLE_EMBEDDINGS=true
