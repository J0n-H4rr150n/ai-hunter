{
    "name": "ai-hunter-frontend",
    "version": "1.0.0",
    "description": "AI Hunter Web UI",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "build:css": "tailwindcss -i ./public/input.css -o ./public/output.css --minify",
        "watch:css": "tailwindcss -i ./public/input.css -o ./public/output.css --watch"
    },
    "dependencies": {
        "express": "^4.18.2"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "tailwindcss": "^3.4.0",
        "autoprefixer": "^10.4.16"
    }
}